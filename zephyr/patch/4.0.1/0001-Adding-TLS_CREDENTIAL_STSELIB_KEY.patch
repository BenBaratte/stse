From 7dd2192e3625e7842432145d4a90636dbfbc8dbe Mon Sep 17 00:00:00 2001
From: Benjamin Baratte <benjamin.baratte@st.com>
Date: Wed, 11 Jun 2025 16:30:46 +0200
Subject: [PATCH] Adding TLS_CREDENTIAL_STSELIB_KEY

---
 include/zephyr/net/tls_credentials.h | 4 ++++
 subsys/net/lib/sockets/sockets_tls.c | 8 ++++++++
 2 files changed, 12 insertions(+)

diff --git a/include/zephyr/net/tls_credentials.h b/include/zephyr/net/tls_credentials.h
index 2804df0610..6c3ca27214 100644
--- a/include/zephyr/net/tls_credentials.h
+++ b/include/zephyr/net/tls_credentials.h
@@ -56,6 +56,10 @@ enum tls_credential_type {
 	 *  corresponding PSK. Used with PSK-based ciphersuites.
 	 */
 	TLS_CREDENTIAL_PSK_ID
+#ifdef CONFIG_MBEDTLS_STSELIB_TLS_CREDENTIAL
+	,
+	TLS_CREDENTIAL_STSELIB_KEY
+#endif
 };
 
 /** Secure tag, a reference to TLS credential
diff --git a/subsys/net/lib/sockets/sockets_tls.c b/subsys/net/lib/sockets/sockets_tls.c
index b28f8aa8be..f54203e9a4 100644
--- a/subsys/net/lib/sockets/sockets_tls.c
+++ b/subsys/net/lib/sockets/sockets_tls.c
@@ -1102,6 +1102,14 @@ static int tls_set_credential(struct tls_context *tls,
 		 */
 		break;
 
+#ifdef CONFIG_MBEDTLS_STSELIB_TLS_CREDENTIAL
+
+	case TLS_CREDENTIAL_STSELIB_KEY:
+		tls->priv_key.pk_info = (const mbedtls_pk_info_t*)cred->buf;
+		break;
+
+
+#endif
 	default:
 		return -EINVAL;
 	}
-- 
2.34.1

